---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AstroCiencias Ecuador",
  description = "Astronomía y más ciencias desde Ecuador. Divulgación científica desde 2012.",
} = Astro.props;

const tituloCompleto =
  title === "AstroCiencias Ecuador" ? title : `${title} · AstroCiencias Ecuador`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Los correos de Netlify Identity enlazan a la portada con el token en el
         hash: se lleva a /escribir/entrar, que es quien lo procesa. -->
    <script is:inline>
      if (
        /^#(invite|recovery|confirmation)_token=/.test(location.hash) &&
        location.pathname.replace(/\/$/, "") !== "/escribir/entrar"
      ) {
        location.replace("/escribir/entrar" + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/escudo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Source+Sans+3:wght@400;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
