---
import { autorDe, fechaCorta, type Articulo } from "../lib/blog";

interface Props {
  articulo: Articulo;
}

const { articulo } = Astro.props;
const { titulo, area, tema, fecha, imagen, imagenAlt } = articulo.data;
const autor = await autorDe(articulo);
const etiqueta = `${tema || area} · ${fechaCorta(fecha)}`.toUpperCase();
---

<a href={`/blog/${articulo.id}`} class="tarjeta">
  <div class="imagen">
    {
      imagen ? (
        <img src={imagen} alt={imagenAlt ?? ""} loading="lazy" />
      ) : (
        <svg aria-hidden="true" width="120" height="120" viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="44" fill="none" stroke="var(--linea-fuerte)" stroke-width="2" stroke-dasharray="3 6" />
          <circle cx="60" cy="60" r="26" fill="none" stroke="var(--dorado)" stroke-width="3" />
          <circle cx="104" cy="60" r="5" fill="var(--azul)" />
        </svg>
      )
    }
  </div>
  <div class="cuerpo">
    <span class="meta">{etiqueta}</span>
    <h3>{titulo}</h3>
    <p class="autor">{autor.data.nombre}</p>
  </div>
</a>

<style>
  .tarjeta {
    text-decoration: none;
    color: var(--texto);
    background: var(--cosmos-2);
    border: 1px solid var(--linea);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .tarjeta:hover {
    color: var(--texto);
    border-color: var(--dorado);
  }

  .imagen {
    height: 190px;
    background: var(--cosmos-3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cuerpo {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dorado);
  }

  h3 {
    font-weight: 600;
    font-size: 21px;
    line-height: 1.3;
  }

  .autor {
    color: var(--texto-suave);
    font-size: 15px;
  }
</style>
