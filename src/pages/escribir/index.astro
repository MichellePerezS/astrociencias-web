---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fechaCorta } from "../../lib/blog";
import { listarBorradores } from "../../lib/borradores";

// Página privada: se genera en el servidor en cada visita.
// El middleware ya ha comprobado la sesión y el rol.
export const prerender = false;

const usuario = Astro.locals.usuario!;
const esEditor = usuario.rol === "editor";

const autores = new Map(
  (await getCollection("autores")).map((a) => [a.id, a.data.nombre]),
);

// Artículos del repositorio (publicados y borradores de Keystatic).
const delRepositorio = (await getCollection("blog")).filter(
  (a) => esEditor || (usuario.autor !== null && a.data.autor.id === usuario.autor),
);

// Borradores del editor propio (Netlify Blobs), ya filtrados por permiso.
const delEditor = await listarBorradores(usuario);

type Estado = "edicion" | "borrador" | "publicado";
interface Fila {
  clave: string;
  titulo: string;
  href: string | null;
  autor: string;
  area: string;
  fecha: Date;
  estado: Estado;
}

const filas: Fila[] = [
  ...delEditor.map((b) => ({
    clave: `e-${b.id}`,
    titulo: b.titulo || "Borrador sin título",
    href: `/escribir/editar/${b.id}`,
    autor: (b.autor && autores.get(b.autor)) || b.propietario.nombre,
    area: b.area ?? "—",
    fecha: new Date(b.actualizado),
    estado: "edicion" as const,
  })),
  ...delRepositorio.map((a) => ({
    clave: `r-${a.id}`,
    titulo: a.data.titulo,
    href: a.data.borrador ? null : `/blog/${a.id}`,
    autor: autores.get(a.data.autor.id) ?? a.data.autor.id,
    area: a.data.tema || a.data.area,
    fecha: a.data.fecha,
    estado: (a.data.borrador ? "borrador" : "publicado") as Estado,
  })),
].sort((a, b) => b.fecha.getTime() - a.fecha.getTime());

const ETIQUETAS: Record<Estado, string> = {
  edicion: "En edición",
  borrador: "Borrador",
  publicado: "Publicado",
};

const autorVinculado = usuario.autor ? autores.get(usuario.autor) : undefined;
---

<Base title="Escribir" description="Zona privada del equipo editorial de ACE.">
  <section class="contenedor encabezado">
    <div class="titulo">
      <p class="etiqueta">// Zona privada · {esEditor ? "Editor" : "Autor"}</p>
      <h1>{esEditor ? "Todos los artículos" : "Tus artículos"}</h1>
      <p class="sesion">
        Has entrado como <strong>{usuario.nombre}</strong>
        {usuario.nombre !== usuario.correo && <span>({usuario.correo})</span>}
      </p>
    </div>
    <div class="acciones">
      <a href="/escribir/nuevo" class="boton boton-principal">Nuevo artículo</a>
      <a href="/escribir/entrar?salir=1" class="boton boton-secundario">Cerrar sesión</a>
    </div>
  </section>

  <section class="contenedor cuerpo">
    {
      !esEditor && !usuario.autor && (
        <p class="aviso" role="status">
          Tu cuenta todavía no está vinculada a una ficha de autor, así que aquí solo ves los
          borradores que escribas en este editor. Pide a un editor que te asigne el rol
          <code>autor:&lt;tu-ficha&gt;</code> en Netlify.
        </p>
      )
    }
    {
      !esEditor && usuario.autor && !autorVinculado && (
        <p class="aviso" role="status">
          Tu cuenta apunta a la ficha «{usuario.autor}», que no existe en
          src/content/autores. Pide a un editor que lo revise.
        </p>
      )
    }

    {
      filas.length > 0 ? (
        <>
          <p class="resumen">
            {filas.length} {filas.length === 1 ? "artículo" : "artículos"}
            {delEditor.length > 0 && ` · ${delEditor.length} en edición`}
          </p>
          <div class="tabla">
            <table>
              <thead>
                <tr>
                  <th scope="col">Título</th>
                  {esEditor && <th scope="col">Autor</th>}
                  <th scope="col">Área</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Estado</th>
                </tr>
              </thead>
              <tbody>
                {filas.map((f) => (
                  <tr>
                    <td class="col-titulo">{f.href ? <a href={f.href}>{f.titulo}</a> : f.titulo}</td>
                    {esEditor && <td>{f.autor}</td>}
                    <td>{f.area}</td>
                    <td class="col-fecha">{fechaCorta(f.fecha)}</td>
                    <td>
                      <span class:list={["estado", f.estado]}>{ETIQUETAS[f.estado]}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="leyenda">
            <strong>En edición</strong>: borradores de este editor, sin publicar.
            <strong>Borrador</strong>: artículos del repositorio marcados como borrador.
          </p>
        </>
      ) : (
        <p class="vacio">
          Todavía no hay artículos. <a href="/escribir/nuevo">Empieza uno nuevo</a>.
        </p>
      )
    }
  </section>
</Base>

<style>
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: 64px 32px;
  }

  .titulo {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sesion {
    color: var(--texto-suave);
  }

  .sesion span {
    color: var(--texto-tenue);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-24);
  }

  .aviso {
    background: var(--cosmos-2);
    border: 1px solid var(--dorado);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--dorado);
  }

  .resumen {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--texto-tenue);
  }

  .tabla {
    overflow-x: auto;
    border: 1px solid var(--linea);
    border-radius: var(--radius-md);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 16px;
  }

  th {
    text-align: left;
    font-family: var(--font-titulos);
    font-weight: 600;
    font-size: 14px;
    color: var(--texto-suave);
    background: var(--cosmos-2);
  }

  th,
  td {
    padding: 12px 16px;
    vertical-align: top;
  }

  tbody tr {
    border-top: 1px solid var(--linea);
  }

  .col-titulo {
    font-weight: 600;
  }

  .col-fecha {
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  .estado {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid;
    white-space: nowrap;
  }

  .edicion {
    color: var(--texto);
    background: var(--cosmos-3);
  }

  .borrador {
    color: var(--dorado);
  }

  .publicado {
    color: var(--azul);
  }

  .leyenda,
  .vacio {
    color: var(--texto-tenue);
    font-size: 14px;
  }

  .vacio {
    font-size: 17px;
    color: var(--texto-suave);
  }
</style>
