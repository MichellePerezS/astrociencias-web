---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fechaCorta } from "../../lib/blog";

// Página privada: se genera en el servidor en cada visita.
// El middleware ya ha comprobado la sesión y el rol.
export const prerender = false;

const usuario = Astro.locals.usuario!;
const esEditor = usuario.rol === "editor";

const autores = new Map(
  (await getCollection("autores")).map((a) => [a.id, a.data.nombre]),
);

// Incluye borradores: es la vista de trabajo del equipo.
const todos = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const articulos = esEditor
  ? todos
  : usuario.autor
    ? todos.filter((a) => a.data.autor.id === usuario.autor)
    : [];

const autorVinculado = usuario.autor ? autores.get(usuario.autor) : undefined;
const borradores = articulos.filter((a) => a.data.borrador).length;
---

<Base title="Escribir" description="Zona privada del equipo editorial de ACE.">
  <section class="contenedor encabezado">
    <div class="titulo">
      <p class="etiqueta">// Zona privada · {esEditor ? "Editor" : "Autor"}</p>
      <h1>{esEditor ? "Todos los artículos" : "Tus artículos"}</h1>
      <p class="sesion">
        Has entrado como <strong>{usuario.nombre}</strong>
        {usuario.nombre !== usuario.correo && <span>({usuario.correo})</span>}
      </p>
    </div>
    <a href="/escribir/entrar?salir=1" class="boton boton-secundario">Cerrar sesión</a>
  </section>

  <section class="contenedor cuerpo">
    {
      !esEditor && !usuario.autor && (
        <p class="aviso" role="status">
          Tu cuenta todavía no está vinculada a una ficha de autor. Pide a un editor que
          te asigne el rol <code>autor:&lt;tu-ficha&gt;</code> en Netlify.
        </p>
      )
    }
    {
      !esEditor && usuario.autor && !autorVinculado && (
        <p class="aviso" role="status">
          Tu cuenta apunta a la ficha «{usuario.autor}», que no existe en
          src/content/autores. Pide a un editor que lo revise.
        </p>
      )
    }

    {
      articulos.length > 0 && (
        <>
          <p class="resumen">
            {articulos.length} {articulos.length === 1 ? "artículo" : "artículos"}
            {borradores > 0 && ` · ${borradores} en borrador`}
          </p>
          <div class="tabla">
            <table>
              <thead>
                <tr>
                  <th scope="col">Título</th>
                  {esEditor && <th scope="col">Autor</th>}
                  <th scope="col">Área</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Estado</th>
                </tr>
              </thead>
              <tbody>
                {articulos.map((a) => (
                  <tr>
                    <td class="col-titulo">
                      {a.data.borrador ? (
                        a.data.titulo
                      ) : (
                        <a href={`/blog/${a.id}`}>{a.data.titulo}</a>
                      )}
                    </td>
                    {esEditor && <td>{autores.get(a.data.autor.id) ?? a.data.autor.id}</td>}
                    <td>{a.data.tema || a.data.area}</td>
                    <td class="col-fecha">{fechaCorta(a.data.fecha)}</td>
                    <td>
                      <span class:list={["estado", a.data.borrador ? "borrador" : "publicado"]}>
                        {a.data.borrador ? "Borrador" : "Publicado"}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      articulos.length === 0 && (esEditor || autorVinculado) && (
        <p class="vacio">Todavía no hay artículos.</p>
      )
    }
  </section>
</Base>

<style>
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: 64px 32px;
  }

  .titulo {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sesion {
    color: var(--texto-suave);
  }

  .sesion span {
    color: var(--texto-tenue);
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-24);
  }

  .aviso {
    background: var(--cosmos-2);
    border: 1px solid var(--dorado);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--dorado);
  }

  .resumen {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--texto-tenue);
  }

  .tabla {
    overflow-x: auto;
    border: 1px solid var(--linea);
    border-radius: var(--radius-md);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 16px;
  }

  th {
    text-align: left;
    font-family: var(--font-titulos);
    font-weight: 600;
    font-size: 14px;
    color: var(--texto-suave);
    background: var(--cosmos-2);
  }

  th,
  td {
    padding: 12px 16px;
    vertical-align: top;
  }

  tbody tr {
    border-top: 1px solid var(--linea);
  }

  .col-titulo {
    font-weight: 600;
  }

  .col-fecha {
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  .estado {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid;
    white-space: nowrap;
  }

  .borrador {
    color: var(--dorado);
  }

  .publicado {
    color: var(--azul);
  }

  .vacio {
    color: var(--texto-suave);
  }
</style>
