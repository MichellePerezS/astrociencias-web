---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PaginaEditor from "../../../components/editor/PaginaEditor.astro";
import { leerBorrador } from "../../../lib/borradores";
import { accionesPermitidas, puedeEditar, ultimaDevolucion } from "../../../lib/flujo";

export const prerender = false;

const usuario = Astro.locals.usuario!;
// leerBorrador comprueba el permiso: un autor solo obtiene sus borradores.
// Si no existe o no es suyo, se responde igual (404) para no revelar nada.
const encontrado = await leerBorrador(usuario, Astro.params.id ?? "");
if (!encontrado) Astro.response.status = 404;

const borrador = encontrado?.borrador;
const nota =
  borrador && borrador.propietario.id !== usuario.id ? `Borrador de ${borrador.propietario.nombre}` : undefined;

// El comentario solo se muestra mientras está devuelto; el historial completo va aparte.
const devolucion = borrador?.estado === "devuelto" ? ultimaDevolucion(borrador.historial) : null;

// Fichas de autor para el formulario de publicación (solo editores, solo si está aprobado).
const autores =
  borrador?.estado === "aprobado" && usuario.rol === "editor"
    ? (await getCollection("autores"))
        .map((a) => ({ id: a.id, nombre: a.data.nombre }))
        .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"))
    : [];
---

{
  encontrado && borrador ? (
    <PaginaEditor
      titulo={borrador.titulo || "Borrador sin título"}
      nota={nota}
      historial={borrador.historial}
      datos={{
        id: borrador.id,
        version: encontrado.version,
        titulo: borrador.titulo,
        resumen: borrador.resumen,
        area: borrador.area,
        imagen: borrador.imagen,
        imagenAlt: borrador.imagenAlt,
        contenido: borrador.contenido,
        actualizado: borrador.actualizado,
        estadoRevision: borrador.estado,
        editable: puedeEditar(usuario, borrador),
        acciones: accionesPermitidas(usuario, borrador),
        devolucion: devolucion
          ? { comentario: devolucion.comentario ?? "", por: devolucion.por.nombre, fecha: devolucion.fecha }
          : null,
        autor: borrador.autor,
        autores,
        publicacion: borrador.publicacion
          ? { slug: borrador.publicacion.slug, urlCommit: borrador.publicacion.urlCommit }
          : null,
      }}
    />
  ) : (
    <Base title="Borrador no encontrado">
      <section class="contenedor no-encontrado">
        <p class="etiqueta">// 404</p>
        <h1>No encontramos este borrador</h1>
        <p>Puede que se haya borrado o que no tengas acceso a él.</p>
        <a href="/escribir" class="boton boton-principal">Volver a la lista</a>
      </section>
    </Base>
  )
}

<style>
  .no-encontrado {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: 96px;
  }

  h1 {
    font-size: clamp(30px, 5vw, 40px);
  }

  p {
    color: var(--texto-suave);
  }
</style>
