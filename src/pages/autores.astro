---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { articulosPublicados, fechaCorta, iniciales } from "../lib/blog";

const autores = (await getCollection("autores")).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, "es"),
);
const articulos = await articulosPublicados();
const articulosDe = (id: string) => articulos.filter((a) => a.data.autor.id === id);
---

<Base
  title="Autores"
  description="Las personas que escriben el blog de AstroCiencias Ecuador."
>
  <section class="contenedor encabezado">
    <p class="etiqueta">// Autores</p>
    <h1>Quién escribe en el blog</h1>
    <p class="entradilla">
      Equipo y voluntariado de ACE que divulgan ciencia desde Ecuador.
      <a href="/colabora/escribe">¿Quieres escribir con nosotros?</a>
    </p>
  </section>

  <section class="contenedor lista" aria-label="Autores">
    {
      autores.map((autor) => {
        const { nombre, rol, bio, foto, enlace } = autor.data;
        const suyos = articulosDe(autor.id);
        return (
          <article class="autor" id={autor.id}>
            {foto ? (
              <img src={foto} alt="" class="avatar" width="88" height="88" loading="lazy" />
            ) : (
              <div class="avatar" aria-hidden="true">
                {iniciales(nombre)}
              </div>
            )}
            <div class="datos">
              <h2>{nombre}</h2>
              {rol && <p class="rol">{rol}</p>}
              {bio && <p class="bio">{bio}</p>}
              {enlace && (
                <a href={enlace} class="enlace" rel="noopener">
                  Web o red social
                </a>
              )}
              {suyos.length > 0 && (
                <div class="articulos">
                  <h3 class="etiqueta">
                    {suyos.length === 1 ? "1 artículo" : `${suyos.length} artículos`}
                  </h3>
                  <ul>
                    {suyos.map((a) => (
                      <li>
                        <a href={`/blog/${a.id}`}>{a.data.titulo}</a>
                        <span class="fecha">{fechaCorta(a.data.fecha)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </section>
</Base>

<style>
  .encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: 72px var(--space-12);
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .entradilla {
    font-size: 19px;
    color: var(--texto-suave);
    max-width: 620px;
  }

  .lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: 20px;
    padding-bottom: var(--space-24);
  }

  .autor {
    display: flex;
    gap: 20px;
    background: var(--cosmos-2);
    border: 1px solid var(--linea);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    scroll-margin-top: var(--space-6);
  }

  .autor:target {
    border-color: var(--dorado);
  }

  .avatar {
    flex: 0 0 88px;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--cosmos-3);
    border: 1px solid var(--linea-fuerte);
    color: var(--dorado);
    font-family: var(--font-titulos);
    font-weight: 600;
    font-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .datos {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h2 {
    font-weight: 600;
    font-size: 22px;
  }

  .rol {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dorado);
  }

  .bio {
    color: var(--texto-suave);
    font-size: 16px;
    margin-top: 4px;
  }

  .enlace {
    align-self: flex-start;
    padding: 6px 0;
    font-size: 15px;
  }

  .articulos {
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--linea);
  }

  .articulos h3 {
    font-size: 12px;
    font-weight: 400;
  }

  ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    font-size: 16px;
  }

  .fecha {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--texto-tenue);
  }

  @media (max-width: 480px) {
    .autor {
      flex-direction: column;
    }
  }
</style>
