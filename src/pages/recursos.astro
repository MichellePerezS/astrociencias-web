---
import Base from "../layouts/Base.astro";

// Recursos de ACE: revista, podcast, radio, charlas y biblioteca virtual.
// Los enlaces externos se abren en una pestaña nueva. Sin `href`, la tarjeta
// se muestra como «Próximamente».

interface Recurso {
  titulo: string;
  texto: string;
  /** Sin enlace todavía: se muestra «Próximamente». */
  href?: string;
  /** Texto del enlace al pie de la tarjeta. */
  accion?: string;
  /** Trazos del icono (viewBox 0 0 24 24, línea). */
  icono: string;
}

const recursos: Recurso[] = [
  {
    titulo: "Revista Astro&Ciencias",
    texto: "Los números de nuestra revista trimestral.",
    icono:
      '<path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/>',
  },
  {
    titulo: "Podcast",
    texto: "Episodios de divulgación en Spotify.",
    href: "https://open.spotify.com/show/7sxgxENn3kVSwzXwgUkYZ7",
    accion: "Escuchar en Spotify",
    icono: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  },
  {
    titulo: "AstroCiencias Radio",
    texto: "Emisión en línea.",
    href: "https://zeno.fm/radio/astrociencias-radio/",
    accion: "Escuchar la radio",
    icono:
      '<circle cx="12" cy="12" r="2"/><path d="M8 8a5.7 5.7 0 0 0 0 8M16 8a5.7 5.7 0 0 1 0 8M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14"/>',
  },
  {
    titulo: "Charlas en vídeo",
    texto: "Directos y charlas en YouTube.",
    href: "https://www.youtube.com/@AstroCienciasEcuador",
    accion: "Ver en YouTube",
    icono: '<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10 9.5l5 2.5-5 2.5z"/>',
  },
  {
    titulo: "Biblioteca virtual",
    texto: "Documentos y libros de divulgación.",
    href: "https://drive.google.com/drive/folders/1m6BUBP_GkV5G9-xTc8h2rQ9zUUXroDuI?usp=drive_link",
    accion: "Abrir la biblioteca",
    icono: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  },
];
---

<Base
  title="Recursos"
  description="Revista, podcast, radio, charlas en vídeo y biblioteca virtual de AstroCiencias Ecuador."
>
  <section class="contenedor encabezado">
    <p class="etiqueta">// Recursos</p>
    <h1>Ciencia para leer, ver y escuchar</h1>
    <p class="entradilla">
      La revista, el podcast, la radio, las charlas y la biblioteca virtual de AstroCiencias Ecuador.
    </p>
  </section>

  <section class="contenedor lista" aria-label="Recursos">
    <ul class="tarjetas">
      {
        recursos.map((r) => {
          const icono = (
            <svg
              class="icono"
              aria-hidden="true"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={r.icono}
            />
          );
          return (
            <li>
              {r.href ? (
                <a class="tarjeta" href={r.href} target="_blank" rel="noopener noreferrer">
                  {icono}
                  <h2 class="titulo">{r.titulo}</h2>
                  <p class="texto">{r.texto}</p>
                  <span class="accion">
                    {r.accion}
                    {/* Espacio duro: la flecha no se queda sola en otra línea. */}
                    <span aria-hidden="true">{" ↗"}</span>
                    <span class="oculto"> (se abre en una pestaña nueva)</span>
                  </span>
                </a>
              ) : (
                <div class="tarjeta">
                  {icono}
                  <h2 class="titulo">{r.titulo}</h2>
                  <p class="texto">{r.texto}</p>
                  <span class="marca">Próximamente</span>
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<style>
  /* Cabecera como en /blog y /autores. */
  .encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: 72px var(--space-12);
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 760px;
  }

  .entradilla {
    font-size: 19px;
    color: var(--texto-suave);
    max-width: 620px;
  }

  .lista {
    padding-bottom: var(--space-24);
  }

  .tarjetas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  /* 3 + 2 en tableta y portátil pequeño (con 4 columnas la quinta quedaría sola); 5 en escritorio. */
  @media (min-width: 600px) {
    .tarjetas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .tarjetas {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .tarjetas li {
    display: flex;
  }

  .tarjeta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    background: var(--cosmos-2);
    border: 1px solid var(--linea);
    border-radius: var(--radius-md);
    color: var(--texto);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .icono {
    color: var(--azul);
    margin-bottom: 4px;
  }

  .titulo {
    font-weight: 600;
    font-size: 18px;
    line-height: 1.25;
  }

  .texto {
    margin: 0;
    color: var(--texto-suave);
    font-size: 15px;
    line-height: 1.45;
  }

  /* Al pie de la tarjeta, aunque los textos tengan distinta altura. */
  .accion {
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-titulos);
    font-weight: 600;
    font-size: 15px;
    color: var(--azul);
  }

  a.tarjeta:hover {
    border-color: var(--azul);
  }

  a.tarjeta:hover .accion {
    color: var(--azul-hover);
  }

  .marca {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dorado);
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta {
      transition: none;
    }
  }

  /* Solo para lectores de pantalla. */
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
