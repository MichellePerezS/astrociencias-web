---
import Base from "../../layouts/Base.astro";
import TarjetaArticulo from "../../components/TarjetaArticulo.astro";
import { articulosPublicados } from "../../lib/blog";

const articulos = await articulosPublicados();
---

<Base
  title="Blog"
  description="Artículos de astronomía y más ciencias escritos por el equipo de AstroCiencias Ecuador."
>
  <section class="contenedor encabezado">
    <p class="etiqueta">// Blog</p>
    <h1>Artículos de ciencia desde Ecuador</h1>
    <p class="entradilla">
      Astronomía, física, biología, ciencias de la Tierra y tecnología, explicadas por
      el equipo y el voluntariado de ACE.
    </p>
  </section>

  <section class="contenedor lista" aria-label="Artículos">
    {
      articulos.length > 0 ? (
        <div class="rejilla">
          {articulos.map((a) => <TarjetaArticulo articulo={a} />)}
        </div>
      ) : (
        <p class="vacio">Todavía no hay artículos publicados.</p>
      )
    }
  </section>
</Base>

<style>
  .encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: 72px var(--space-12);
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 760px;
  }

  .entradilla {
    font-size: 19px;
    color: var(--texto-suave);
    max-width: 620px;
  }

  .lista {
    padding-bottom: var(--space-24);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .vacio {
    color: var(--texto-suave);
  }
</style>
