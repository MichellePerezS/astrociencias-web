---
// Portada simplificada: el bloque «Destacado» (último artículo o, cuando
// exista, el próximo evento) y debajo los últimos artículos, sin repetir el
// destacado.
import Base from "../layouts/Base.astro";
import Destacado from "../components/Destacado.astro";
import UltimosArticulos from "../components/UltimosArticulos.astro";
import { obtenerDestacado } from "../lib/destacado";

const destacado = await obtenerDestacado();
---

<Base>
  <h1 class="solo-lectores">AstroCiencias Ecuador</h1>
  {destacado && <Destacado destacado={destacado} />}
  <UltimosArticulos excluir={destacado?.articuloId} />
</Base>

<style>
  /* Título de la página para lectores de pantalla; la portada no lo muestra. */
  .solo-lectores {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
