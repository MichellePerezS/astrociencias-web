# Copia este archivo como .env para trabajar en local.

# Netlify Identity del sitio publicado (para probar /escribir con `astro dev`).
# En Netlify no hace falta: el servidor usa la URL del propio sitio.
IDENTITY_URL=https://[tu-sitio].netlify.app/.netlify/identity
PUBLIC_IDENTITY_URL=https://[tu-sitio].netlify.app/.netlify/identity

# Comentarios del blog con Cusdis.
PUBLIC_CUSDIS_APP_ID=
