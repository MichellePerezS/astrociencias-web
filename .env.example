# Copia este archivo como .env para trabajar en local.

# Netlify Identity del sitio publicado (para probar /escribir con `astro dev`).
# En Netlify no hace falta: el servidor usa la URL del propio sitio.
IDENTITY_URL=https://[tu-sitio].netlify.app/.netlify/identity
# El navegador no puede llamar a otro origen (CORS): usa el proxy local de
# astro.config.mjs, que reenvía a IDENTITY_URL. En Netlify no se define.
PUBLIC_IDENTITY_URL=/identidad-dev

# Comentarios del blog con Cusdis.
PUBLIC_CUSDIS_APP_ID=

# Publicación en GitHub (fase 4). Token fine-grained con «Contents: Read and
# write» solo en este repositorio. En Netlify se definen en Site configuration →
# Environment variables (marca el token como secreto). Nunca con PUBLIC_.
# En local, solo si quieres publicar de verdad desde `astro dev`.
ACE_GITHUB_TOKEN=
ACE_GITHUB_REPO=MichellePerezS/astrociencias-web
ACE_GITHUB_RAMA=main
